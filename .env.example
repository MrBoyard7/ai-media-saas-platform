# Copy to `.env` and adjust for your environment. Never commit the real `.env` file.

APP_ENV=local
DEBUG=true

# --- Security ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# --- Supabase (self-hosted) --------------------------------------------------
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=change-me-to-match-your-supabase-instance

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_media_platform

# --- Redis / Celery -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS -----------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- GPU / Provider infrastructure ------------------------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
STORAGE_BUCKET_URL=

# --- Credits ----------------------------------------------------------------------
DEFAULT_SIGNUP_CREDITS=100
LOW_BALANCE_WARNING_THRESHOLD=20
